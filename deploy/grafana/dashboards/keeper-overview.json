{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Operational view for the alula-liquidator keeper. Top row answers 'is the bot alive?'; middle rows answer 'what did it do and why?'; bottom rows answer 'is the plumbing healthy?'.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 13,
      "type": "stat",
      "title": "Scrape up",
      "description": "up{job=\"alula-keeper\"}. 1 = Prometheus is reaching /metrics; 0 = the keeper is unreachable. Distinguishes 'bot dead' from 'bot up but idle'.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"alula-keeper\"}",
          "legendFormat": "scrape",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Time since last successful scan",
      "description": "time() - liquidator_last_successful_scan_timestamp_seconds. Green ≤30s, yellow ≤60s, red beyond. One value per market. Shows 'No data' before the first successful scan — pair with the Scrape up panel to disambiguate.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "time() - liquidator_last_successful_scan_timestamp_seconds{market=~\"$market\"}",
          "legendFormat": "{{market}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 30, "color": "yellow"},
              {"value": 60, "color": "red"}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Plans dispatched (1h)",
      "description": "increase(liquidator_liquidation_plans_dispatched_total[1h]). Global counter (no market label). `or vector(0)` keeps the panel showing 0 (red) on fresh deploys instead of 'No data'.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(liquidator_liquidation_plans_dispatched_total[1h])) or on() vector(0)",
          "legendFormat": "plans",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 1, "color": "blue"}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "TXs confirmed (1h)",
      "description": "increase(keeper_tx_confirmed_total{outcome=\"confirmed\"}[1h]). Global counter (no market label). The bot is doing real work iff this is non-zero. `or vector(0)` shows red 0 on fresh deploy instead of 'No data'.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(keeper_tx_confirmed_total{outcome=\"confirmed\"}[1h])) or on() vector(0)",
          "legendFormat": "confirmed",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 1, "color": "green"}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "XLM funding",
      "description": "Keeper's XLM wallet balance (in XLM, not stroops). XLM funds inclusion fees; once it falls below `xlm_safety_margin` the bot stops submitting. Set the `xlm` dashboard variable to the XLM SAC contract address on your deployed network.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "liquidator_asset_balance{token_address=\"$xlm\"} / 10000000",
          "legendFormat": "XLM",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 100, "color": "yellow"},
              {"value": 1000, "color": "green"}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Liquidation pipeline — plans → submitted → confirmed",
      "description": "Steady-state: all three series track each other. Plans > submitted = simulation rejects in the executor path. Submitted > confirmed could be pending confirmations, poll failures, or finalization failures — check the TX confirmation outcomes panel for the cause.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 5},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(liquidator_liquidation_plans_dispatched_total[5m])) or on() vector(0)",
          "legendFormat": "plans dispatched"
        },
        {
          "refId": "B",
          "expr": "sum(rate(keeper_tx_submitted_total{outcome=\"ok\"}[5m])) or on() vector(0)",
          "legendFormat": "tx submitted ok"
        },
        {
          "refId": "C",
          "expr": "sum(rate(keeper_tx_confirmed_total{outcome=\"confirmed\"}[5m])) or on() vector(0)",
          "legendFormat": "tx confirmed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scan loop — completed by outcome",
      "description": "rate(liquidator_scan_completed_total[5m]) by outcome. 'ok' should dominate; 'no_obligations' is expected on quiet markets; 'no_market_data' on sustained basis means the data feed is broken.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(liquidator_scan_completed_total{market=~\"$market\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never"
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "ok"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "no_obligations"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byName", "options": "no_market_data"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Obligations vs liquidatable positions",
      "description": "Watched borrower count (liquidator_obligations_total) vs the subset currently flagged liquidatable per market. Sustained zero liquidatable with non-zero obligations is suspicious — likely engine/oracle drift.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [
        {
          "refId": "A",
          "expr": "liquidator_obligations_total{market=~\"$market\"}",
          "legendFormat": "{{market}} obligations"
        },
        {
          "refId": "B",
          "expr": "liquidator_liquidatable_positions{market=~\"$market\"}",
          "legendFormat": "{{market}} liquidatable"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*liquidatable.*"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}},
            {"id": "custom.axisPlacement", "value": "right"},
            {"id": "custom.axisLabel", "value": "liquidatable"}
          ]},
          {"matcher": {"id": "byRegexp", "options": ".*obligations.*"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}},
            {"id": "custom.axisLabel", "value": "obligations"}
          ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Skip reasons",
      "description": "Why try_liquidate returned None. Fixed taxonomy of ≤8 reasons. A reason spiking 10× vs baseline is the early signal worth investigating.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(liquidator_skip_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never"
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "below_collateral_threshold"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
          {"matcher": {"id": "byName", "options": "unprofitable_seize_zero"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byRegexp", "options": ".*(failed|error).*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Simulation outcomes",
      "description": "sum by (call, outcome) (rate(keeper_simulation_total[5m])). A growing 'not_liquidatable' bucket means engine/contract drift; growing 'error' means RPC trouble.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (call, outcome) (rate(keeper_simulation_total[5m]))",
          "legendFormat": "{{call}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never"
          }
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".* / ok$"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byRegexp", "options": ".* / not_liquidatable$"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byRegexp", "options": ".* / (error|failed)$"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "TX submission outcomes",
      "description": "sum by (outcome) (rate(keeper_tx_submitted_total[5m])). 'retry_exhausted' or 'sim_empty' sustained is a red flag.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(keeper_tx_submitted_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never"
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "ok"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "sim_empty"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byRegexp", "options": "retry_exhausted|seq_acquire_failed|unreachable"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "TX confirmation outcomes",
      "description": "sum by (outcome) (rate(keeper_tx_confirmed_total[5m])). 'poll_failed' or 'hash_decode_failed' indicates an RPC layer regression.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(keeper_tx_confirmed_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": {"mode": "normal", "group": "A"},
            "showPoints": "never"
          }
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "confirmed"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byRegexp", "options": "poll_failed|hash_decode_failed"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Reactor back-pressure (dropped events)",
      "description": "Any non-zero rate means the engine is dropping events because a downstream consumer (strategy, executor) couldn't keep up. Always operationally urgent.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (collector) (rate(keeper_collector_lagged_events_total[5m]))",
          "legendFormat": "collector: {{collector}}"
        },
        {
          "refId": "B",
          "expr": "rate(engine_strategy_lagged_events_total[5m]) or on() vector(0)",
          "legendFormat": "strategy"
        },
        {
          "refId": "C",
          "expr": "rate(engine_executor_lagged_actions_total[5m]) or on() vector(0)",
          "legendFormat": "executor"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "State persistence & sequence retries",
      "description": "Cursor save failures = the keeper can't persist its event cursor (SQLite IO trouble). Bad-seq retries = stellar sequence-number contention on the signing key.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(keeper_cursor_save_failures_total[5m]))",
          "legendFormat": "cursor save fail: {{source}}"
        },
        {
          "refId": "B",
          "expr": "rate(keeper_tx_bad_seq_retries_total[5m]) or on() vector(0)",
          "legendFormat": "bad_seq retries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": "cursor save fail.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byName", "options": "bad_seq retries"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Wallet balances per asset",
      "description": "Raw on-chain balances per asset the keeper holds. Falling to zero blocks Own/PreSwap liquidation modes and dust-stops the rebalancer. XLM caps inclusion-fee headroom (xlm_safety_margin).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 45},
      "targets": [
        {
          "refId": "A",
          "expr": "liquidator_asset_balance",
          "legendFormat": "{{token_address}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Keeper self-position per market",
      "description": "The keeper's own jTokens (supply), dTokens (borrow), and plain collateral per market. The withdrawer strategy acts on the jToken series; non-zero dTokens mean the keeper is itself a borrower and is exposed to liquidation risk.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 45},
      "targets": [
        {"refId": "A", "expr": "liquidator_self_j_tokens_underlying", "legendFormat": "supply {{token_symbol}}"},
        {"refId": "B", "expr": "liquidator_self_d_tokens_underlying", "legendFormat": "borrow {{token_symbol}}"},
        {"refId": "C", "expr": "liquidator_self_plain_collateral", "legendFormat": "collateral {{token_symbol}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "XLM balance vs safety margin",
      "description": "Live XLM balance overlaid against the configured xlm_safety_margin. The margin is the floor the rebalancer/liquidator refuse to spend below to preserve inclusion-fee headroom. When the balance line approaches the margin line, refill before the keeper starts skipping opportunities.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 53},
      "targets": [
        {"refId": "A", "expr": "liquidator_asset_balance{token_address=\"$xlm\"} / 10000000", "legendFormat": "balance (XLM)"},
        {"refId": "B", "expr": "liquidator_xlm_safety_margin_stroops / 10000000", "legendFormat": "safety margin (XLM)"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "safety margin (XLM)"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}},
            {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}
          ]},
          {"matcher": {"id": "byName", "options": "balance (XLM)"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}
          ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "min"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Market scan latency (per-market quantiles)",
      "description": "Wall-clock time spent inside one market evaluation, by outcome. Sustained p95 above ~1s usually means RPC roundtrips are slow (`read_market_data` or `read_user_obligation`); flat-but-rising p50 means more obligations are being checked. The `outcome` dimension separates fast early-exits (`no_market_data`, `no_obligations`) from full scans (`ok`).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 61},
      "targets": [
        {"refId": "A", "expr": "liquidator_market_scan_duration_seconds{quantile=\"0.5\", market=~\"$market\"}", "legendFormat": "p50 {{market}} / {{outcome}}"},
        {"refId": "B", "expr": "liquidator_market_scan_duration_seconds{quantile=\"0.95\", market=~\"$market\"}", "legendFormat": "p95 {{market}} / {{outcome}}"},
        {"refId": "C", "expr": "liquidator_market_scan_duration_seconds{quantile=\"0.99\", market=~\"$market\"}", "legendFormat": "p99 {{market}} / {{outcome}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": "^p50.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byRegexp", "options": "^p95.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byRegexp", "options": "^p99.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "RPC simulate latency — p95 by contract function",
      "description": "Per-function p95 of `simulate_transaction_envelope` roundtrips. This is the next-level-down view when `Market scan latency` looks bad — it tells you which contract call is slow (e.g. `get_market_data` vs `get_user_obligation` vs swap-provider quotes). Outcomes split `ok` from `transport_error` so failed RPCs don't dilute the latency signal.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 69},
      "targets": [
        {"refId": "A", "expr": "keeper_rpc_simulate_duration_seconds{quantile=\"0.95\", outcome=\"ok\"}", "legendFormat": "p95 {{function}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never"}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "RPC simulate failures by function (rate/min)",
      "description": "Per-function rate of failed simulate calls, split by `kind`: `transport` = network-layer error (RPC unreachable / 5xx), `sim_error` = the simulator returned a structured error response. Transport errors mean switch providers; sim_errors usually mean a contract input went bad.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 69},
      "targets": [
        {"refId": "A", "expr": "60 * rate(keeper_rpc_simulate_failures_total[5m])", "legendFormat": "{{kind}} / {{function}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": "^transport.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byRegexp", "options": "^sim_error.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    }
  ],
