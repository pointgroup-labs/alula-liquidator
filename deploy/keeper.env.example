# Copy to `keeper.env` (gitignored) and fill in.
# Loaded by the production stack in deploy/docker-compose.yml.

# Stellar secret key (S... 56 chars). Required.
STELLAR_SKEY=

# tracing-subscriber filter directive.
RUST_LOG=info,alula_keeper=info,alula_engine=info

# Webhook URL Alertmanager posts to on fire/resolve. Slack/PagerDuty/your own
# receiver. Leave empty in dev — alerts will fail to deliver but the stack
# still starts.
ALERTMANAGER_WEBHOOK_URL=

# Grafana initial admin login. Change on first login.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
