
# Stellar secret key for the keeper (S... 56 chars). Required.
# Read by clap as the env-var fallback for `--skey` and interpolated
# into both `docker-compose.yml` (root, local) and `deploy/docker-compose.yml`
# (production stack) — keep the variable name in sync with both.
STELLAR_SKEY=

# tracing-subscriber filter directive.
RUST_LOG=info,alula_keeper=info,alula_engine=info

# Grafana initial admin login (change on first login).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# Contact email Let's Encrypt uses for expiry warnings on the
# stats.alula.finance certificate. Required by Traefik's ACME resolver
# in `deploy/docker-compose.yml`.
ACME_EMAIL=
