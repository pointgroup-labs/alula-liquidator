# Local dev environment for `docker compose up`.
# Copy to `.env` and fill in the secret. `.env` is gitignored.

# Stellar account secret key for the liquidator (SECRET... 56-char strkey).
# Required. Compose will refuse to start if this is empty.
STELLAR_SKEY=

# Tracing filter. Defaults to info-level for our crates, warn for deps.
RUST_LOG=info,alula_keeper=info,alula_engine=info

# Grafana admin credentials (first-login default: admin / admin).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
